# Optional weekly AI summary (requires Cloudflare Worker — see AGENTS.md)
VITE_ENABLE_WEEKLY_AI_SUMMARY=0
VITE_WEEKLY_AI_ENDPOINT=
# GitHub secret WEEKLY_AI_TOKEN must match worker WEEKLY_SUMMARY_TOKEN
VITE_WEEKLY_AI_TOKEN=

# Optional projector AI Search (same Worker — see AGENTS.md)
VITE_ENABLE_PROJECTOR_AI_SEARCH=0
VITE_PROJECTOR_SEARCH_ENDPOINT=
# Optional; falls back to VITE_WEEKLY_AI_TOKEN when unset
VITE_PROJECTOR_SEARCH_TOKEN=
# Optional: confirm before closing search when follow-ups exist (default off)
VITE_ENABLE_PJS_CLOSECONF=0

# Optional Web Push (same Cloudflare Worker — see AGENTS.md)
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_API_BASE=
VITE_FEEDBACK_FORM_ENDPOINT=
# Cloudflare Turnstile site key (public, optional override)
VITE_FEEDBACK_TURNSTILE_SITE_KEY=

# Optional Firebase sync + share links (Spark free tier — see docs/FIREBASE.md)
VITE_ENABLE_FIREBASE=0
VITE_ENABLE_FIREBASE_SYNC=0
VITE_ENABLE_SHARE_LINKS=0
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Tauri desktop auth (see docs/FIREBASE.md)
# Web client ID from Google Cloud → Credentials → OAuth 2.0 Web client
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Optional override for email-link continue URL in native builds
# VITE_NATIVE_AUTH_CONTINUE_URL=https://projects.sillylittle.tech/mentell/auth/deeplink.html
