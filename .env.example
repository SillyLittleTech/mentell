# Optional weekly AI summary (requires Cloudflare Worker — see AGENTS.md)
# Set to 1 and point endpoint at your worker URL to show the UI on /week
VITE_ENABLE_WEEKLY_AI_SUMMARY=0
# Local: http://127.0.0.1:8787/weekly-summary  |  Prod: https://<worker>.workers.dev/weekly-summary
VITE_WEEKLY_AI_ENDPOINT=
# Must match worker secret WEEKLY_SUMMARY_TOKEN (also set as GitHub secret WEEKLY_AI_TOKEN)
VITE_WEEKLY_AI_TOKEN=
