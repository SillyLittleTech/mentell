rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /publicShares/{shareCode} {
      function isOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      function isCreatingOwner() {
        return request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      }

      function hasSnapshotPayload() {
        return request.resource.data.mode == 'snapshot'
          && request.resource.data.keys().hasAll(['payload']);
      }

      function hasProtectedPayload() {
        return request.resource.data.mode == 'protected'
          && request.resource.data.keys().hasAll(['payloadEnvelope']);
      }

      allow read: if resource.data.expiresAt > request.time || isOwner();
      allow create: if isCreatingOwner()
        && request.resource.data.keys().hasAll([
          'ownerUid', 'expiresAt', 'permissions', 'shareUrl', 'mode'
        ])
        && (hasSnapshotPayload() || hasProtectedPayload());
      allow update, delete: if isOwner();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /stickies/{stickyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /packages/{packageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /meta/{metaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /shareLinks/{code} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
