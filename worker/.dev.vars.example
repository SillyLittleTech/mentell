# Copy to worker/.dev.vars (gitignored) for local wrangler dev
# Quote tokens that contain # @ ! etc. (otherwise # starts a comment)
WEEKLY_SUMMARY_TOKEN="your-token-here"
# Optional; defaults to WEEKLY_SUMMARY_TOKEN when unset
# PROJECTOR_SEARCH_TOKEN="your-token-here"
# AI Gateway id for Workers AI (weekly summary + projector fallbacks). Configure rate limits on this gateway.
# Do NOT put rate limits on any gateway attached to the AI Search instance.
# AI_GATEWAY_ID=mentell-workers-ai
# Web Push — REQUIRED for /push/test and delayed push in wrangler dev (secrets alone are not enough locally)
# Generate: npx web-push generate-vapid-keys
# Use the same pair as production wrangler secret put VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Firebase service account JSON (one line) for cron Firestore reads when users sync
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional extra CORS host suffixes (comma-separated), e.g. ".myotherdomain.com"
# ALLOWED_HOST_SUFFIXES=".sillylittle.tech"
# Email notifications (Resend). Use published template ids/aliases, not unpublished drafts.
# RESEND_API_KEY=re_...
# RESEND_FROM=Mentell <notifications@mentell.sillylittle.tech>
# RESEND_TEMPLATE_VERIFY=
# RESEND_TEMPLATE_DAILY=
# RESEND_TEMPLATE_PACKAGE=
# Public app URL used in verification links (no trailing slash)
# MENTELL_PUBLIC_URL=http://127.0.0.1:5173
