{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "deep-link:default",
    "opener:default",
    {
      "identifier": "opener:allow-default-urls",
      "allow": [{ "url": "mentell://*" }]
    },
    "allow-start-auth-callback",
    "allow-stop-auth-callback"
  ]
}
