{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "deep-link:default",
    "opener:allow-default-urls",
    "oauth:allow-start",
    "oauth:allow-cancel"
  ]
}
