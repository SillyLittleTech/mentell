{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mentell",
  "version": "1.18.33",
  "identifier": "com.mentell.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mentell",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SillyLittleTech/mentell/releases/latest/download/updater.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "mentell"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
