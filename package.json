{
  "name": "mentell",
  "private": true,
  "version": "2.0.10",
  "type": "module",
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "pose:lab": "elixir scripts/pose_lab.exs",
    "tauri": "tauri",
    "dev": "vite",
    "dev:tauri": "VITE_TAURI=1 vite",
    "dev:debug": "vite --mode debug",
    "dev:debug:auth": "VITE_DEBUG_ENABLE_AUTH=1 vite --mode debug",
    "tauri:dev": "tauri dev",
    "build": "npm run sync:assets && tsc -b && vite build",
    "build:offline-zip": "npm run sync:assets && tsc -b && VITE_OFFLINE_ZIP=1 VITE_BASE=./ SKIP_PWA=1 vite build",
    "build:check": "npm run sync:assets && tsc -b && SKIP_PWA=1 vite build",
    "build:debug": "tsc -b && vite build --mode debug",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "worker:dev": "cd worker && npm run dev",
    "worker:deploy": "cd worker && npm run deploy"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@xenova/transformers": "^2.17.2",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "cargo": "^0.8.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "firebase": "^12.19.0",
    "framer-motion": "^13.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
