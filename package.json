{
  "name": "mentell",
  "private": true,
  "version": "1.17.27",
  "type": "module",
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "pose:lab": "elixir scripts/pose_lab.exs",
    "tauri": "tauri",
    "dev": "vite",
    "dev:tauri": "VITE_TAURI=1 vite",
    "dev:debug": "vite --mode debug",
    "dev:debug:auth": "VITE_DEBUG_ENABLE_AUTH=1 vite --mode debug",
    "tauri:dev": "tauri dev",
    "build": "npm run sync:assets && tsc -b && vite build",
    "build:offline-zip": "npm run sync:assets && tsc -b && VITE_OFFLINE_ZIP=1 VITE_BASE=./ SKIP_PWA=1 vite build",
    "build:check": "npm run sync:assets && tsc -b && SKIP_PWA=1 vite build",
    "build:debug": "tsc -b && vite build --mode debug",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "worker:dev": "cd worker && npm run dev",
    "worker:deploy": "cd worker && npm run deploy"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xenova/transformers": "^2.17.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.2",
    "firebase": "^12.16.0",
    "framer-motion": "^13.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
