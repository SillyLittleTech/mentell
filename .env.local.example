# Copy to .env.local (gitignored)

# Weekly AI (optional) — talks to your Mentell Worker, NOT AI Gateway directly
# VITE_ENABLE_WEEKLY_AI_SUMMARY=1
# VITE_WEEKLY_AI_ENDPOINT=http://127.0.0.1:8787/weekly-summary
# Must match WEEKLY_SUMMARY_TOKEN in worker/.dev.vars
# VITE_WEEKLY_AI_TOKEN="dev-local-token"

# Projector AI Search (optional) — also talks to your Mentell Worker (/projector-search)
# Do NOT put an AI Gateway URL or Cloudflare API token here.
# VITE_ENABLE_PROJECTOR_AI_SEARCH=1
# VITE_PROJECTOR_SEARCH_ENDPOINT=http://127.0.0.1:8787/projector-search
# Same shared app token as weekly AI (or PROJECTOR_SEARCH_TOKEN on the worker)
# VITE_PROJECTOR_SEARCH_TOKEN="dev-local-token"
# Optional: confirm before closing search when follow-ups exist (default off)
# VITE_ENABLE_PJS_CLOSECONF=1

# AI Gateway is configured on the Worker only (worker/.dev.vars):
#   AI_GATEWAY_ID=default
# (from a URL like …/v1/<accountId>/default/compat/… the gateway id is "default")
# Never put gateway.ai.cloudflare.com URLs in VITE_* vars.

# Web Push (optional — same worker origin as weekly AI)
# VITE_VAPID_PUBLIC_KEY=<public key from npx web-push generate-vapid-keys>
# VITE_PUSH_API_BASE=http://127.0.0.1:8787
# VITE_FEEDBACK_FORM_ENDPOINT=https://sillylittle.workflows.okta.com/api/flo/f76fd87ce1bcd200569e2e10fc636fae/invoke
# VITE_FEEDBACK_TURNSTILE_SITE_KEY=0x4AAAAAADfOpVgdUWD5E_c1

# Firebase (optional) — project men-tell-prod
# VITE_ENABLE_FIREBASE=1
# VITE_ENABLE_FIREBASE_SYNC=1
# VITE_ENABLE_SHARE_LINKS=1
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=men-tell-prod.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=men-tell-prod
# VITE_FIREBASE_STORAGE_BUCKET=men-tell-prod.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Debug only (npm run dev:debug) — Firebase is off by default (isolated storage, no real sign-in).
# Option A: automated DEBUGGER session (Admin SDK custom token, uid DEBUGGER):
# VITE_DEBUG_FIREBASE_CUSTOM_TOKEN=
# Option B: real Google/email sign-in while keeping debug storage (or use npm run dev:debug:auth):
# VITE_DEBUG_ENABLE_AUTH=1
# Tauri desktop dev uses npm run tauri:dev (sets VITE_TAURI=1 + real AuthProvider automatically).
